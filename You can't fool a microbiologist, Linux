#commentsHolder { background-color: transparent; border-top: 1px dashed rgb(204, 204, 204); border-bottom: 1px dashed rgb(204, 204, 204); height: 252px; padding: 0px; position: relative; }

#commentsHolder .dialog { background-color: rgb(255, 255, 255); box-sizing: border-box; color: rgb(117, 117, 117); display: none; left: 50px; margin-top: 4px; max-width: calc(100% - 56px); padding: 10px; position: absolute; top: 10px; width: 378px; z-index: 1; }

