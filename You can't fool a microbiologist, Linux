#commentsHolder .dialog input[type="button"] { color: rgb(33, 150, 243); padding: 0px; }

#commentsHolder .dialog .group { margin-bottom: 10px; }

#commentsHolder .continue_btn { float: right; }

.commentBodyContainer { box-sizing: border-box; margin-top: 75px; padding-left: 64px; position: absolute; top: 0px; width: 100%; }

#commentBodyField { background-color: transparent; border: 0px; box-sizing: border-box; color: rgb(117, 117, 117); font: 16px Roboto, sans-serif; height: 142px; outline: none; padding-top: 0px; resize: none; width: inherit; }

#commentSelectorLabel { color: rgb(117, 117, 117); font-weight: 700; margin-right: 10px; }

