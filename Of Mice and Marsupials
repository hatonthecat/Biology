<meta content="https://inavoyage.blogspot.com/2026/04/of-mice-and-marsupials.html">
<a class="timestamp-link" href="https://inavoyage.blogspot.com/2026/04/of-mice-and-marsupials.html" rel="bookmark" title="permanent link">
<time class="published" datetime="2026-04-17T18:46:00-07:00" title="2026-04-17T18:46:00-07:00">
April 17, 2026
</time>
</a>
